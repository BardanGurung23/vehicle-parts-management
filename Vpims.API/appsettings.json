{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "ConnectionStrings": {
    "defaultConnection": "Server=localhost;Database=DATABASE_NAME;Port=5432;User Id=YOUR_POSTGRES_USERNAME;Password=YOUR_POSTGRES_PASSWORD"
  },

  "Jwt": {
    "Issuer": "Autonix.Api",
    "Audience": "Autonix.Client",
    "Key": "CHANGE_THIS_TO_A_LONG_DEVELOPMENT_SECRET_KEY",
    "ExpirationMinutes": 120
  },

  "AllowedHosts": "*"
}
