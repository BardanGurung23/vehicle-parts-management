{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "ConnectionStrings": {
    "defaultConnection": "Host=localhost;Port=5432;Database=autonix_db"
  },
  "DatabaseInitialization": {
    "Provider": "Postgres",
    "InMemoryDatabaseName": "AutonixDevDb",
    "AutoResetOnSchemaMismatch": true,
    "SeedDemoData": true
  },
  "Jwt": {
    "Issuer": "Autonix.Api",
    "Audience": "Autonix.Client",
    "Key": "replace-with-jwt-key-from-env-minimum-32-characters",
    "ExpirationMinutes": 120
  },
  "InvoiceEmail": {
    "Host": "",
    "Port": 587,
    "Username": "",
    "Password": "",
    "FromEmail": "noreply@autonix.local",
    "FromName": "Autonix",
    "EnableSsl": true
  },
  "PasswordReset": {
    "FrontendBaseUrl": "http://localhost:7001",
    "TokenLifetimeMinutes": 60
  },
  "AlertConfiguration": {
    "LowStockThreshold": 10,
    "OverdueCreditMonthsThreshold": 1,
    "DashboardAlertLimit": 5
  },
  "AllowedHosts": "*"
}
